# Server
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=mudassir@amsitservices.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Mudassir Shaik
CLIENT_ORIGIN=http://localhost:5173

# Website chat assistant. Uses an OpenAI-compatible gateway when CHAT_BASE_URL is set,
# otherwise Claude via ANTHROPIC_API_KEY, otherwise the built-in FAQ answers.
CHAT_BASE_URL=https://llm.amsventures.co.in
CHAT_API_KEY=
CHAT_MODEL=auto
# ANTHROPIC_API_KEY=

# Public URL of the site, used for links and the logo in emails
SITE_URL=https://amsitservices.com

# Email (SMTP): verification codes, password resets and notifications.
# GoDaddy Professional Email / Workspace: smtpout.secureserver.net, port 465 (SSL) or 587 (STARTTLS)
# GoDaddy Microsoft 365 email:            smtp.office365.com, port 587 (SMTP AUTH must be enabled for the mailbox)
# Leave SMTP_HOST empty to print emails to the server console instead (development).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mudassir@amsitservices.com
SMTP_PASS=
MAIL_FROM=mudassir@amsitservices.com
MAIL_FROM_NAME=AMS IT Services
# Where new-message / quote-request notifications go (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=mudassir@amsitservices.com

# Image generation (scripts/generate-images.mjs only — never sent to the browser)
FAL_KEY=
